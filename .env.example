# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Local default: fake. Production: openai | gigachat | deepseek.
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# GigaChat (LLM_PROVIDER=gigachat). GIGACHAT_CREDENTIALS is the authorization key;
# access tokens (30 min) are obtained and cached automatically.
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_TIMEOUT_SECONDS=30
# Both GigaChat hosts are signed by the Russian Trusted Root CA (not in default trust stores).
# In Docker use the bundled public CA: GIGACHAT_CA_BUNDLE=/app/certs/russian_trusted_root_ca_pem.crt
GIGACHAT_CA_BUNDLE=

# DeepSeek (LLM_PROVIDER=deepseek), Responses API.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# Local default: memory. Production: postgres.
RELATIONSHIP_BACKEND=memory
DATABASE_URL=postgresql+asyncpg://svoi_pravila:svoi_pravila@postgres:5432/svoi_pravila

# Local default: memory. Production: redis.
CHECKPOINT_BACKEND=memory
REDIS_URL=redis://redis:6379/0
REDIS_CHECKPOINT_TTL_SECONDS=1200

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://example.com/v1/telegram/webhook
TELEGRAM_DEFAULT_WORKFLOW=soften

# Mini App initData validation
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
