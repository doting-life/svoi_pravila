{
  "name": "@svoi-pravila/miniapp-client",
  "version": "0.6.0",
  "description": "Typed fetch client for the Svoi Pravila Telegram Mini App API (/v1/miniapp).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../docs/openapi.json -o src/generated/openapi.ts --default-non-nullable false",
    "check:generated": "openapi-typescript ../../docs/openapi.json -o src/generated/openapi.ts --default-non-nullable false --check",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.6.3",
    "vitest": "^2.1.4"
  }
}
